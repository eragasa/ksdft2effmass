{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eragasa/ksdft2effmass/specification/periodic-calculation-record/v1/periodic-calculation-record.schema.json",
  "title": "Periodic calculation record schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "absolute_energy_reference", "atom_count", "atoms", "band_count",
    "basis_identity", "direct_lattice_convention", "direct_lattice_unit",
    "direct_lattice_vectors", "eigenvalues", "energy_unit", "exit_status",
    "fermi_alignment_convention", "fft_box", "fft_grid", "fft_smooth", "gauge",
    "k_point_convention", "k_point_count", "k_point_weights", "k_points",
    "occupations", "phase_convention", "position_convention", "position_unit",
    "producing_application", "producing_application_version", "qexsd_namespace",
    "qexsd_version", "reciprocal_lattice_convention", "reciprocal_lattice_unit",
    "reciprocal_lattice_vectors", "retained_subspace", "schema_version",
    "source_byte_count", "source_path", "source_sha256", "species", "spin_channels",
    "spin_convention", "total_energy", "total_energy_unit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_path": {"type": "string", "pattern": "^/", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_byte_count": {"type": "integer", "minimum": 0},
    "qexsd_namespace": {"type": "string", "minLength": 1},
    "qexsd_version": {"type": "string", "minLength": 1},
    "producing_application": {"type": "string", "minLength": 1},
    "producing_application_version": {"type": ["string", "null"]},
    "direct_lattice_vectors": {"$ref": "#/$defs/threeVectors"},
    "direct_lattice_unit": {"$ref": "#/$defs/text"},
    "direct_lattice_convention": {"$ref": "#/$defs/text"},
    "reciprocal_lattice_vectors": {"$ref": "#/$defs/threeVectors"},
    "reciprocal_lattice_unit": {"$ref": "#/$defs/text"},
    "reciprocal_lattice_convention": {"$ref": "#/$defs/text"},
    "species": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/species"}},
    "atoms": {"type": "array", "items": {"$ref": "#/$defs/atom"}},
    "atom_count": {"type": "integer", "minimum": 1},
    "position_unit": {"$ref": "#/$defs/text"},
    "position_convention": {"$ref": "#/$defs/text"},
    "k_points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vector"}},
    "k_point_weights": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
    "k_point_count": {"type": "integer", "minimum": 1},
    "k_point_convention": {"$ref": "#/$defs/text"},
    "eigenvalues": {"$ref": "#/$defs/spectrum"},
    "occupations": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/spectrum"}]},
    "energy_unit": {"$ref": "#/$defs/text"},
    "band_count": {"type": "integer", "minimum": 1},
    "spin_channels": {"anyOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}]},
    "total_energy": {"type": "number"},
    "total_energy_unit": {"$ref": "#/$defs/text"},
    "fft_grid": {"$ref": "#/$defs/grid"},
    "fft_smooth": {"$ref": "#/$defs/grid"},
    "fft_box": {"$ref": "#/$defs/grid"},
    "exit_status": {"type": "integer", "minimum": 0, "maximum": 255},
    "absolute_energy_reference": {"$ref": "#/$defs/unavailable"},
    "fermi_alignment_convention": {"$ref": "#/$defs/unavailable"},
    "retained_subspace": {"$ref": "#/$defs/unavailable"},
    "gauge": {"$ref": "#/$defs/unavailable"},
    "phase_convention": {"$ref": "#/$defs/unavailable"},
    "basis_identity": {"$ref": "#/$defs/unavailable"},
    "spin_convention": {"$ref": "#/$defs/unavailable"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "threeVectors": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vector"}},
    "grid": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
    "species": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/text"}, {"type": "number"}, {"$ref": "#/$defs/text"}], "items": false},
    "atom": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"type": "integer", "minimum": 1}, {"$ref": "#/$defs/text"}, {"$ref": "#/$defs/vector"}], "items": false},
    "spectrum": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}},
    "unavailable": {"enum": ["not_represented_in_qexsd", "no_spin_resolved_arrays_in_qexsd", "no_retained_subspace_represented_in_qexsd"]}
  }
}
