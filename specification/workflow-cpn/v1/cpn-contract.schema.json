    "stringSequence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validationIssueCode": {
      "enum": [
        "duplicate_identifier",
        "unknown_color",
        "unknown_place",
        "unknown_transition",
        "color_not_allowed",
        "payload_type_not_allowed",
        "duplicate_binding_variable",
        "unbound_variable",
        "model_id_mismatch",
        "place_set_mismatch",
        "duplicate_token_id",
        "token_in_multiple_places",
        "token_color_mismatch",
        "invalid_initial_marking"
      ]
    },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "related_ids",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/validationIssueCode"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_ids": {
          "$ref": "#/$defs/ids"
        },
        "message": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues"
      ],
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationIssue"
          }
        }
      }
    },
    "guardEvaluationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "boolean"
        }
      }
    },
    "transitionEnablementResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "bindings"
      ],
      "properties": {
        "transition_id": {
          "$ref": "#/$defs/id"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "errorCode": {
      "enum": [
        "invalid_definition",
        "invalid_marking",
        "unknown_transition",
        "invalid_binding",
        "transition_not_enabled",
        "guard_evaluation_failed",
        "expression_type_mismatch",
        "output_id_count_mismatch",
        "output_id_collision",
        "terminal_token_consumption",
        "invalid_produced_token",
        "revision_overflow"
      ]
    }
  }
}
