{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksdft2effmass.org/pi-harness-incubation/H0/component-inventory/v1",
  "title": "H0 harness component inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "inventory_scope", "granularity_policy", "component_count", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"const": "H0"},
    "inventory_scope": {"type": "string", "minLength": 1},
    "granularity_policy": {"type": "string", "minLength": 1},
    "component_count": {"type": "integer", "minimum": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id", "component_kind", "current_path", "current_owner",
        "declared_capability", "actual_behavior", "trigger_or_caller", "inputs",
        "outputs", "consumers", "direct_dependencies", "project_path_dependencies",
        "project_domain_dependencies", "control_plane_dependencies",
        "external_dependencies", "state_or_side_effects", "tests_or_evidence",
        "current_authority", "duplication_or_overlap", "candidate_destination",
        "classification", "classification_rationale", "migration_risk",
        "open_questions", "capability"
      ],
      "properties": {
        "component_id": {"type": "string", "pattern": "^[A-Z]+-[A-Z0-9]+$"},
        "component_kind": {"type": "string", "minLength": 1},
        "current_path": {"type": "string", "minLength": 1},
        "current_owner": {"type": "string", "minLength": 1},
        "declared_capability": {"type": "string", "minLength": 1},
        "actual_behavior": {"type": "string", "minLength": 1},
        "trigger_or_caller": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/stringArray"},
        "outputs": {"$ref": "#/$defs/stringArray"},
        "consumers": {"$ref": "#/$defs/stringArray"},
        "direct_dependencies": {"$ref": "#/$defs/stringArray"},
        "project_path_dependencies": {"$ref": "#/$defs/stringArray"},
        "project_domain_dependencies": {"$ref": "#/$defs/stringArray"},
        "control_plane_dependencies": {"$ref": "#/$defs/stringArray"},
        "external_dependencies": {"$ref": "#/$defs/stringArray"},
        "state_or_side_effects": {"type": "string", "minLength": 1},
        "tests_or_evidence": {"$ref": "#/$defs/stringArray"},
        "current_authority": {
          "enum": ["AUTHORITATIVE", "DERIVED", "ADVISORY", "HISTORICAL_EVIDENCE", "DUPLICATE", "UNRESOLVED"]
        },
        "duplication_or_overlap": {"type": "string", "minLength": 1},
        "candidate_destination": {"type": "string", "minLength": 1},
        "classification": {
          "enum": ["EXTRACTABLE", "SPLIT_GENERIC_AND_LOCAL", "KEEP_PROJECT_LOCAL", "RETIRE_AS_DUPLICATE", "DEFER"]
        },
        "classification_rationale": {"type": "string", "minLength": 1},
        "migration_risk": {"enum": ["low", "medium", "high"]},
        "open_questions": {"$ref": "#/$defs/stringArray"},
        "capability": {"type": "string", "minLength": 1}
      }
    }
  }
}
