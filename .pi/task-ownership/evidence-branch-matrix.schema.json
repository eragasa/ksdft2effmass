{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksdft2effmass.org/schemas/task-ownership/evidence-branch-matrix/v1",
  "title": "Evidence branch orchestration matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "task_id",
    "task_record",
    "profile",
    "authorization",
    "claim_boundary",
    "validation_stages",
    "branches"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "matrix_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "task_record": {"type": "string", "pattern": "^(?:\\.pi/tasks/.+\\.md|harness/tasks/.+\\.json)$"},
    "profile": {"const": "evidence-branches-v1"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "decision_id", "rationale"],
      "properties": {
        "record": {"type": "string", "minLength": 1},
        "decision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "validation_stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/validationStage"}
    },
    "branches": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/branch"}
    }
  },
  "$defs": {
    "pathArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "validationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "owner_role",
        "command",
        "evidence_paths",
        "requirements"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["validation", "completion"]},
        "owner_role": {"type": "string", "minLength": 1},
        "command": {"$ref": "#/$defs/command"},
        "evidence_paths": {"$ref": "#/$defs/pathArray"},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner_role",
        "owned_paths",
        "requirements",
        "evidence_paths",
        "prerequisites",
        "classification",
        "checkpoint_ids",
        "validation_stage_ids"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "owner_role": {"type": "string", "minLength": 1},
        "owned_paths": {"$ref": "#/$defs/pathArray"},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_paths": {"$ref": "#/$defs/pathArray"},
        "prerequisites": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "classification": {
          "enum": ["deterministic_now", "protected_checkpoint"]
        },
        "checkpoint_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "validation_stage_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"classification": {"const": "deterministic_now"}},
            "required": ["classification"]
          },
          "then": {"properties": {"checkpoint_ids": {"maxItems": 0}}}
        },
        {
          "if": {
            "properties": {"classification": {"const": "protected_checkpoint"}},
            "required": ["classification"]
          },
          "then": {"properties": {"checkpoint_ids": {"minItems": 1}}}
        }
      ]
    }
  }
}
