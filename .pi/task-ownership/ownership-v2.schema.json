{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksdft2effmass.org/schemas/task-ownership/v2",
  "title": "Generic task ownership launch contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_record",
    "owners",
    "completion_validator"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "task_id": {"type": "string", "minLength": 1},
    "task_record": {"type": "string", "pattern": "^(?:\\.pi/tasks/.+\\.md|harness/tasks/.+\\.json)$"},
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writers", "reviewers"],
      "properties": {
        "writers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/owner"}
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reviewer"}
        }
      }
    },
    "completion_validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "command", "required_before_review"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "required_before_review": {"const": true}
      }
    },
    "orchestration_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "branch_matrix", "correction_cycle_limit"],
      "properties": {
        "profile": {"const": "evidence-branches-v1"},
        "branch_matrix": {"type": "string", "minLength": 1},
        "correction_cycle_limit": {"const": 1}
      }
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "agent", "agent_record", "owned_paths"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "agent_record": {"type": "string", "pattern": "^\\.pi/agents/.+\\.md$"},
        "owned_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "agent", "agent_record"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "agent_record": {"type": "string", "pattern": "^\\.pi/agents/.+\\.md$"}
      }
    }
  }
}
