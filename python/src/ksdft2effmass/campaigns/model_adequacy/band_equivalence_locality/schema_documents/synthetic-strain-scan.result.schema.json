{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ksdft2effmass.campaign.model-adequacy.gauge-locality-under-synthetic-strain.scan.result.v1",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extreme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "value": {"type": "number"}
      },
      "required": ["strain_fraction", "value"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_band": {"$ref": "#/$defs/extreme"},
        "maximum_hamiltonian": {"$ref": "#/$defs/extreme"},
        "rms_band": {"$ref": "#/$defs/extreme"},
        "rms_hamiltonian": {"$ref": "#/$defs/extreme"},
        "sample_count": {"type": "integer", "minimum": 1}
      },
      "required": ["maximum_band", "maximum_hamiltonian", "rms_band", "rms_hamiltonian", "sample_count"]
    },
    "nullable_error": {
      "oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]
    },
    "witness_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control": {"enum": ["geometry-only-control", "frozen-parent-null-response-control", "synthetic-radial-response-control"]},
        "fixed_candidate_maximum": {"type": "number"},
        "fixed_candidate_maximum_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "maximum_correlation": {"type": "number"},
        "maximum_correlation_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "maximum_splitting_scale": {"type": "number"},
        "maximum_splitting_scale_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "minimum_correlation": {"type": "number"},
        "minimum_correlation_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "minimum_splitting_scale": {"type": "number"},
        "minimum_splitting_scale_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "optimized_maximum": {"type": "number"},
        "optimized_maximum_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      },
      "required": ["control", "fixed_candidate_maximum", "fixed_candidate_maximum_strain_fraction", "maximum_correlation", "maximum_correlation_strain_fraction", "maximum_splitting_scale", "maximum_splitting_scale_strain_fraction", "minimum_correlation", "minimum_correlation_strain_fraction", "minimum_splitting_scale", "minimum_splitting_scale_strain_fraction", "optimized_maximum", "optimized_maximum_strain_fraction"]
    },
    "locality_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_physical_radius": {"type": ["number", "null"]},
        "maximum_physical_radius_strain_fraction": {"type": ["number", "null"]},
        "maximum_retained_blocks": {"type": ["integer", "null"]},
        "maximum_retained_blocks_strain_fraction": {"type": ["number", "null"]},
        "tail_tolerance": {"type": "number", "exclusiveMinimum": 0.0}
      },
      "required": ["maximum_physical_radius", "maximum_physical_radius_strain_fraction", "maximum_retained_blocks", "maximum_retained_blocks_strain_fraction", "tail_tolerance"]
    },
    "response_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control": {"enum": ["frozen-parent-null-response-control", "synthetic-radial-response-control"]},
        "maximum_aligned_hamiltonian_defect": {"type": "number", "minimum": 0.0},
        "maximum_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      },
      "required": ["control", "maximum_aligned_hamiltonian_defect", "maximum_strain_fraction"]
    },
    "qualification_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control": {"enum": ["frozen-parent-null-response-control", "synthetic-radial-response-control"]},
        "external_isolation_gap": {"$ref": "#/$defs/extreme"},
        "frame_overlap_singular_value": {"$ref": "#/$defs/extreme"},
        "pointwise_frame_alignment_residual": {"$ref": "#/$defs/extreme"},
        "restricted_global_frame_alignment_residual": {"$ref": "#/$defs/extreme"},
        "seed_overlap": {"$ref": "#/$defs/extreme"}
      },
      "required": ["control", "external_isolation_gap", "frame_overlap_singular_value", "pointwise_frame_alignment_residual", "restricted_global_frame_alignment_residual", "seed_overlap"]
    },
    "cutoff_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delta_omitted_power": {"$ref": "#/$defs/extreme"},
        "delta_total": {"$ref": "#/$defs/nullable_error"},
        "delta_truncation": {"$ref": "#/$defs/nullable_error"},
        "omitted_power": {"$ref": "#/$defs/extreme"},
        "tail_tolerance": {"type": "number", "exclusiveMinimum": 0.0},
        "total": {"$ref": "#/$defs/nullable_error"},
        "truncation": {"$ref": "#/$defs/nullable_error"}
      },
      "required": ["delta_omitted_power", "delta_total", "delta_truncation", "omitted_power", "tail_tolerance", "total", "truncation"]
    },
    "approximation_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aligned_strain_perturbation": {"$ref": "#/$defs/error"},
        "control": {"enum": ["frozen-parent-null-response-control", "synthetic-radial-response-control"]},
        "cutoffs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cutoff_envelope"}},
        "delta_interpolation": {"$ref": "#/$defs/error"},
        "delta_nyquist_power": {"$ref": "#/$defs/extreme"},
        "interpolation": {"$ref": "#/$defs/error"},
        "nyquist_power": {"$ref": "#/$defs/extreme"}
      },
      "required": ["aligned_strain_perturbation", "control", "cutoffs", "delta_interpolation", "delta_nyquist_power", "interpolation", "nyquist_power"]
    },
    "mechanism_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control": {"enum": ["frozen-parent-null-response-control", "synthetic-radial-response-control"]},
        "delta_offsite_power_maximum": {"$ref": "#/$defs/extreme"},
        "delta_onsite_power_maximum": {"$ref": "#/$defs/extreme"},
        "hopping_response_maximum": {"$ref": "#/$defs/extreme"},
        "hopping_response_minimum": {"$ref": "#/$defs/extreme"},
        "scalar_component_maximum": {"$ref": "#/$defs/extreme"},
        "scalar_component_rms_maximum": {"$ref": "#/$defs/extreme"},
        "traceless_component_maximum": {"$ref": "#/$defs/extreme"},
        "traceless_component_rms_maximum": {"$ref": "#/$defs/extreme"}
      },
      "required": ["control", "delta_offsite_power_maximum", "delta_onsite_power_maximum", "hopping_response_maximum", "hopping_response_minimum", "scalar_component_maximum", "scalar_component_rms_maximum", "traceless_component_maximum", "traceless_component_rms_maximum"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approximations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/approximation_envelope"}},
        "base_sample_count": {"type": "integer", "minimum": 1},
        "locality": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locality_envelope"}},
        "maximum_direct_band_defect": {"type": "number", "minimum": 0.0},
        "maximum_direct_band_defect_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "maximum_volume_defect": {"type": "number", "minimum": 0.0},
        "maximum_volume_defect_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "mechanisms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/mechanism_envelope"}},
        "qualifications": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/qualification_envelope"}},
        "responses": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/response_envelope"}},
        "status": {"const": "sampled-development-summary-not-continuum-certificate"},
        "witness_requirements": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/witness_envelope"}}
      },
      "required": ["approximations", "base_sample_count", "locality", "maximum_direct_band_defect", "maximum_direct_band_defect_strain_fraction", "maximum_volume_defect", "maximum_volume_defect_strain_fraction", "mechanisms", "qualifications", "responses", "status", "witness_requirements"]
    },
    "shell_transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left_retained_blocks": {"type": ["integer", "null"]},
        "left_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "right_retained_blocks": {"type": ["integer", "null"]},
        "right_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "tail_tolerance": {"type": "number", "exclusiveMinimum": 0.0}
      },
      "required": ["left_retained_blocks", "left_strain_fraction", "right_retained_blocks", "right_strain_fraction", "tail_tolerance"]
    },
    "bond_transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left_distinct_bond_lengths": {"type": "integer", "minimum": 1},
        "left_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "right_distinct_bond_lengths": {"type": "integer", "minimum": 1},
        "right_strain_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      },
      "required": ["left_distinct_bond_lengths", "left_strain_fraction", "right_distinct_bond_lengths", "right_strain_fraction"]
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_sample_count": {"type": "integer", "minimum": 1},
        "bond_degeneracy_transitions": {"type": "array", "items": {"$ref": "#/$defs/bond_transition"}},
        "maximum_final_bracket_width": {"type": "number", "minimum": 0.0},
        "maximum_refinement_depth": {"type": "integer", "minimum": 1, "maximum": 20},
        "shell_transitions": {"type": "array", "items": {"$ref": "#/$defs/shell_transition"}},
        "status": {"const": "sampled-transition-brackets-not-continuum-certificates"}
      },
      "required": ["base_sample_count", "bond_degeneracy_transitions", "maximum_final_bracket_width", "maximum_refinement_depth", "shell_transitions", "status"]
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frozen_response_sha256": {"$ref": "#/$defs/digest"},
        "geometry_sha256": {"$ref": "#/$defs/digest"},
        "radial_response_sha256": {"$ref": "#/$defs/digest"},
        "witnesses": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "control": {"enum": ["geometry-only-control", "frozen-parent-null-response-control", "synthetic-radial-response-control"]},
              "sha256": {"$ref": "#/$defs/digest"}
            },
            "required": ["control", "sha256"]
          }
        }
      },
      "required": ["frozen_response_sha256", "geometry_sha256", "radial_response_sha256", "witnesses"]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {"enum": ["area-preserving-rhombic-triangular-to-square", "volume-preserving-bain-fcc-to-bcc"]},
    "scan_request_sha256": {"$ref": "#/$defs/digest"},
    "schema": {"const": "ksdft2effmass.campaign.model-adequacy.gauge-locality-under-synthetic-strain.scan.result.v1"},
    "source_sha256": {"$ref": "#/$defs/source_sha256"},
    "status": {"const": "sampled-strain-scan-result-not-continuum-certificate"},
    "summary": {"$ref": "#/$defs/summary"},
    "transitions": {"$ref": "#/$defs/transitions"}
  },
  "required": ["path", "scan_request_sha256", "schema", "source_sha256", "status", "summary", "transitions"]
}
