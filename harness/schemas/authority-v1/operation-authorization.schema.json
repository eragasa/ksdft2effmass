    "binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/taskBinding"
        },
        {
          "$ref": "#/$defs/reviewBinding"
        },
        {
          "$ref": "#/$defs/promotionBinding"
        }
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "input_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "operation_binding": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "schema_version",
        "input_identity",
        "operation_binding"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "result_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "status": {
          "enum": [
            "signature_not_required",
            "authorized",
            "denied",
            "error"
          ]
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "requested_signature_requirement_result_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "observed_signature_requirement_result_identity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_identity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization_record_content_identity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorizer_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "result_identity",
        "status",
        "input",
        "requested_signature_requirement_result_identity",
        "observed_signature_requirement_result_identity",
        "context_identity",
        "authorization_id",
        "authorization_record_content_identity",
        "authorizer_version",
        "diagnostics"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "status": {
                  "const": "signature_not_required"
                },
                "observed_signature_requirement_result_identity": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "context_identity": {
                  "type": "null"
                },
                "authorization_id": {
                  "type": "null"
                },
                "authorization_record_content_identity": {
                  "type": "null"
                },
                "diagnostics": {
                  "maxItems": 0
                }
              }
            },
            {
              "properties": {
                "status": {
                  "const": "authorized"
                },
                "observed_signature_requirement_result_identity": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "context_identity": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "authorization_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
                },
                "authorization_record_content_identity": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "diagnostics": {
                  "maxItems": 0
                }
              }
            },
            {
              "properties": {
                "status": {
                  "const": "denied"
                },
                "observed_signature_requirement_result_identity": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "context_identity": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "authorization_id": {
                  "type": "null"
                },
                "authorization_record_content_identity": {
                  "type": "null"
                },
                "diagnostics": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "status": {
                  "const": "error"
                },
                "observed_signature_requirement_result_identity": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "context_identity": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "authorization_id": {
                  "type": "null"
                },
                "authorization_record_content_identity": {
                  "type": "null"
                },
                "diagnostics": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/result"
    }
  ]
}
