{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksdft2effmass.dev/harness/task-signature-configuration-v1.schema.json",
  "title": "Task Signature Configuration and Result v1",
  "$defs": {
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "subject_identity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "subject_identity",
        "detail"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "configuration_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "task_record_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "signature_requirement": {
          "enum": [
            "not_required",
            "required"
          ]
        }
      },
      "required": [
        "schema_version",
        "configuration_identity",
        "task_id",
        "task_record_identity",
        "signature_requirement"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "result_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "status": {
          "enum": [
            "resolved",
            "error"
          ]
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "task_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "signature_requirement": {
          "anyOf": [
            {
              "enum": [
                "not_required",
                "required"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration_identity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "default",
                "explicit"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "result_identity",
        "status",
        "task_id",
        "task_revision",
        "signature_requirement",
        "configuration_identity",
        "source",
        "diagnostics"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "signature_requirement": {
                "type": "null"
              },
              "configuration_identity": {
                "type": "null"
              },
              "source": {
                "type": "null"
              },
              "diagnostics": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/configuration"
    },
    {
      "$ref": "#/$defs/result"
    }
  ]
}
