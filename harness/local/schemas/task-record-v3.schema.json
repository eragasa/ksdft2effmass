{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ksdft2effmass.org/v3/task-record.schema.json",
  "title": "Project-local HarnessTask record version 3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "status",
    "status_detail",
    "parent_task_id",
    "task_prerequisite_ids",
    "external_prerequisite_ids",
    "superseded_by_task_ids",
    "explicit_activation_required",
    "objective",
    "authority_reference_paths",
    "authorized_scope",
    "completion_criteria",
    "exclusions",
    "intake_path",
    "archived_source"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*//)(?!.*\\\\)[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029/]+(?:/[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029/]+)*$"
    },
    "identifier_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "text_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "archived_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 3
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/$defs/identifier"
    },
    "status_detail": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_task_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_prerequisite_ids": {
      "$ref": "#/$defs/identifier_array"
    },
    "external_prerequisite_ids": {
      "$ref": "#/$defs/identifier_array"
    },
    "superseded_by_task_ids": {
      "$ref": "#/$defs/identifier_array"
    },
    "explicit_activation_required": {
      "type": "boolean"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "authority_reference_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/path"
      },
      "uniqueItems": true
    },
    "authorized_scope": {
      "$ref": "#/$defs/text_array"
    },
    "completion_criteria": {
      "$ref": "#/$defs/text_array"
    },
    "exclusions": {
      "$ref": "#/$defs/text_array"
    },
    "intake_path": {
      "oneOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "type": "null"
        }
      ]
    },
    "documentation_path": {
      "$ref": "#/$defs/path"
    },
    "archived_source": {
      "oneOf": [
        {
          "$ref": "#/$defs/archived_source"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
