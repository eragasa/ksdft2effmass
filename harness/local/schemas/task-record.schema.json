{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ksdft2effmass.org/v1/task-record.schema.json",
  "title": "Project-local Task record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "status",
    "parent_task_id",
    "task_prerequisite_ids",
    "external_prerequisite_ids",
    "explicit_activation_required",
    "objective",
    "authority_reference_paths",
    "authorized_scope",
    "completion_criteria",
    "exclusions",
    "intake_path"
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\x00-\\x1f/]+(?:/[^\\x00-\\x1f/]+)*$"},
    "identifier_array": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
    "text_array": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"$ref": "#/$defs/identifier"},
    "title": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/identifier"},
    "parent_task_id": {
      "oneOf": [
        {"$ref": "#/$defs/identifier"},
        {"type": "null"}
      ]
    },
    "task_prerequisite_ids": {"$ref": "#/$defs/identifier_array"},
    "external_prerequisite_ids": {"$ref": "#/$defs/identifier_array"},
    "explicit_activation_required": {"type": "boolean"},
    "objective": {"type": "string", "minLength": 1},
    "authority_reference_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}, "uniqueItems": true},
    "authorized_scope": {"$ref": "#/$defs/text_array"},
    "completion_criteria": {"$ref": "#/$defs/text_array"},
    "exclusions": {"$ref": "#/$defs/text_array"},
    "intake_path": {"$ref": "#/$defs/path"}
  }
}
