{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ksdft2effmass.campaign.model-adequacy.periodic1d.band-equivalence-versus-hopping-locality.truncation.input.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "model", "maximum_ranges", "dense_integer_inventory", "evaluation_mesh_size", "evaluation_mesh_rule", "scope"],
  "properties": {
    "schema": {"const": "ksdft2effmass.campaign.model-adequacy.periodic1d.band-equivalence-versus-hopping-locality.truncation.input.v0"},
    "identity": {"$ref": "#/$defs/identity"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reciprocal_mesh_size", "amplitudes", "amplitude_unit", "minimum_external_gap", "minimum_transport_singular_value", "frame_absolute_tolerance", "harmonic_absolute_degeneracy_tolerance", "harmonic_relative_degeneracy_tolerance", "verification_absolute_tolerance", "parent_hopping_scale"],
      "properties": {
        "reciprocal_mesh_size": {"type": "integer", "minimum": 4},
        "amplitudes": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "amplitude_unit": {"const": "radian"},
        "minimum_external_gap": {"type": "number", "exclusiveMinimum": 0},
        "minimum_transport_singular_value": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "frame_absolute_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "harmonic_absolute_degeneracy_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "harmonic_relative_degeneracy_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "verification_absolute_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "parent_hopping_scale": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "maximum_ranges": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
    "dense_integer_inventory": {"type": "boolean"},
    "evaluation_mesh_size": {"type": "integer", "minimum": 1},
    "evaluation_mesh_rule": {"const": "deterministic-shifted-disjoint-mesh.v1"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_calculator_execution", "material_validation", "protocol_frozen", "provenance_record", "retained_run"],
      "properties": {
        "external_calculator_execution": {"const": false},
        "material_validation": {"const": false},
        "protocol_frozen": {"const": false},
        "provenance_record": {"const": false},
        "retained_run": {"const": false}
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "method_id", "parent_model_id", "reciprocal_coordinate_id", "finite_fourier_id", "ordinary_lattice_conversion_id", "range_rule_id"],
      "properties": {
        "family_id": {"const": "ksdft2effmass.campaign.model-adequacy.periodic1d.band-equivalence-versus-hopping-locality"},
        "method_id": {"const": "nonflat-four-state-ordinary-lattice-truncation.v1"},
        "parent_model_id": {"const": "specified-finite-range-four-state-parent.v1"},
        "reciprocal_coordinate_id": {"const": "q-equals-k-over-reciprocal-period.v1"},
        "finite_fourier_id": {"const": "centered-finite-cyclic-fourier.v1"},
        "ordinary_lattice_conversion_id": {"const": "remove-centered-nyquist-block.v1"},
        "range_rule_id": {"const": "symmetric-ordinary-integer-displacements.v1"}
      }
    }
  }
}
